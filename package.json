{
  "name": "librarydesk-qa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bugDetective": {
    "project": {
      "id": "librarydesk",
      "name": "LibraryDesk",
      "difficulty": "beginner",
      "stack": {
        "frontend": "React · Vite · CSS Modules",
        "backend": "Node.js · Express",
        "database": "MySQL · Sequelize"
      },
      "services": {
        "db": {
          "image": "mysql:8.4",
          "memory": "512m",
          "env": {
            "MYSQL_ROOT_PASSWORD": "librarydesk",
            "MYSQL_DATABASE": "librarydesk"
          },
          "variables": {
            "DATABASE_URL": "mysql://root:librarydesk@{{host}}:{{port}}/librarydesk",
            "MYSQL_HOST": "{{host}}",
            "MYSQL_TCP_PORT": "{{port}}"
          }
        }
      }
    }
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "qa": "node run.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install chromium",
    "test": "vitest run"
  },
  "devDependencies": {
    "@bug-detective/catalog": "github:bug-detective-project/catalog#v1.8.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
